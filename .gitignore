# ── 파이썬 / 자이썬 컴파일 산출물 ────────────────────────────
__pycache__/
*.py[cod]
*$py.class

# ── 매크로 정의·템플릿 이미지 (사용자 결정: 외부 공개 안 함) ───
Macros/

# ── 수동 백업 (git 도입 전 버전관리 대체 수단) ──────────────
Backups/
*.bak-*

# ── 실행 중 생성되는 로그 · 스크린샷 · 상태 파일 ────────────
#    Logs 폴더 자체는 테스트 스크립트가 절대경로로 쓰므로 유지한다
Logs/*
!Logs/.gitkeep

# ── 이 PC에 종속된 런타임 캐시 (해상도별 OCR 좌표) ──────────
tesseract-lastseen.json

# ── 편집기 개인 설정 (창 위치·도크 배치·마지막 연 매크로) ───
#    없으면 settings.DEFAULTS 로 돌아가므로 실행에 필요 없다
Tools/MacroEditor/layout.json
Docs/env-backup-*.txt

# ── OS / 편집기 ─────────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
